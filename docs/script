CREATE DATABASE RaceDayDB; 
 
USE RaceDayDB; 
 
CREATE TABLE ROLES ( 
    ROLESID INT IDENTITY(1,1) PRIMARY KEY, 
    ROLENAME VARCHAR(50) NOT NULL, 
    DESCRIPTION VARCHAR(255) NULL, 
    CreatedAt DATETIME DEFAULT GETDATE() 
); 
